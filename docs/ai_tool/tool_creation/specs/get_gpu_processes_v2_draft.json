  },
  "observation_semantics": {
    "observed": "pid integer, name string, vram_used integer MiB when nvidia-smi returns numeric",
    "unknown": "vram_used 対象だが [N/A]/欠測 — 文字列 \"unknown\"",
    "unsupported": "non-NVIDIA — Tool unavailable, empty processes",
    "unavailable": "nvidia-smi not found"
  },
  "unknown_semantics": {
    "vram_used": "[N/A] → unknown via _safe_int; never 0 or estimated MB",
    "partial_success": "ok=true with all vram_used unknown is valid PARTIAL observation",
    "root_cause": "UNKNOWN — driver/WDDM/permissions (audit Phase 1)"
  },
  "unsupported_semantics": {
    "non_nvidia": "Same as unavailable for v2 baseline"
  },
  "unavailable_semantics": {
    "nvidia_smi_missing": "ok=false, status=unavailable, processes=[]"
  },
  "error_semantics": {
    "empty_processes_ok_true": "No GPU compute apps — not an error",
    "empty_processes_ok_false": "Observation failure"
  },
  "not_provided_fields": {
