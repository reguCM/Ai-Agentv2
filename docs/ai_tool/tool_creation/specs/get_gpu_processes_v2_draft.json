  },
  "field_capability": {
    "processes[].pid": { "tier": "REQUIRED", "evidence": "VERIFIED", "failure": "unknown in item" },
    "processes[].name": { "tier": "REQUIRED", "evidence": "VERIFIED", "failure": "unknown string" },
    "processes[].vram_used": { "tier": "ENVIRONMENT_DEPENDENT", "evidence": "VERIFIED when numeric; PARTIAL when [N/A]", "failure": "unknown string (not 0)" },
