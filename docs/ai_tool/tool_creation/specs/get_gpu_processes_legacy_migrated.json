{
  "tool_id": "local:get_gpu_processes",
  "name": "get_gpu_processes",
  "version": "1.0.0-legacy-migrated",
  "description": "現在GPUを使用しているプロセスを nvidia-smi から実測する。取得不能時は空リストと status/error を返し、固定プロセス一覧へフォールバックしない。",
  "provider": "local",
  "source": "registry/tools.json",
  "capability": ["GPU", "プロセス", "VRAM使用", "observation"],
  "purpose": "nvidia-smi --query-compute-apps から GPU 使用中プロセス（pid, process_name, used_gpu_memory）を実測して返す（Registry 登録 Legacy Tool の現行契約固定）",
  "allowed_operations": ["read"],
  "prohibited_operations": ["write", "modify", "network"],
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "processes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "pid": {},
            "name": {},
            "vram_used": {}
          },
          "required": ["pid", "name", "vram_used"]
        }
      },
      "ok": { "type": "boolean" },
      "status": {},
      "error": {},
      "observation_source": { "const": "real" },
      "source": {}
    },
    "required": ["processes", "ok", "status", "error", "observation_source", "source"]
  },
  "output_fields": {
    "processes": {
      "type": "array",
      "meaning": "GPU compute アプリのリスト。空配列は「プロセスなし」または失敗時",
      "observation_source": "nvidia-smi --query-compute-apps",
      "item_fields": {
        "pid": {
          "type_success": "integer",
          "type_failure_in_item": "string",
          "meaning": "プロセス ID",
          "observation_source": "nvidia-smi pid",
          "unknown_condition": "パース不能時文字列 \"unknown\""
        },
        "name": {
          "type": "string",
          "meaning": "process_name（フルパスまたは [Insufficient Permissions] 等）",
          "observation_source": "nvidia-smi process_name",
          "unknown_condition": "欠測時 \"unknown\""
        },
        "vram_used": {
          "type_success": "integer",
          "type_failure_in_item": "string",
          "unit": "mib",
          "meaning": "used_gpu_memory（プロセス別 VRAM 使用量）",
          "observation_source": "nvidia-smi used_gpu_memory",
          "unknown_condition": "[N/A] / n/a / 空 / パース不能 → 文字列 \"unknown\"（0 や推定値で埋めない）",
          "observation_validity": "PARTIAL — 権限・ドライバ都合で unknown が多い"
        }
      }
    },
    "ok": {
      "type": "boolean",
      "meaning": "観測成功=true（空リスト含む）/ 失敗=false",
      "observation_source": "DERIVED_VALUE"
    },
    "status": {
      "type": "string",
      "meaning": "成功 \"ok\"；nvidia-smi 不在 \"unavailable\"；その他 \"error\"",
      "observation_source": "DERIVED_VALUE"
    },
    "error": {
      "type": "string|null",
      "meaning": "失敗理由（例: nvidia-smi_not_found, nvidia_smi_timeout）；成功時 null",
      "observation_source": "DERIVED_VALUE"
    },
    "observation_source": {
      "type": "string",
      "const": "real",
      "meaning": "常に \"real\" — 固定 ollama/python リストを返さない契約",
      "observation_source": "CONFIG_VALUE"
    },
    "source": {
      "type": "string",
      "meaning": "\"nvidia-smi\" | \"none\"",
      "observation_source": "DERIVED_VALUE"
    }
  },
  "not_provided_fields": {
    "gpu_id": {
      "status": "NOT_PROVIDED",
      "note": "compute-apps クエリに GPU index フィールドなし。マルチ GPU 時の GPU 識別子は返さない"
    },
    "process_count": {
      "status": "NOT_PROVIDED",
      "note": "len(processes) で導出可能だが独立キーなし"
    }
  },
  "success_format": "ok=true, processes=[{pid,name,vram_used},...], status=ok, error=null",
  "error_format": {
    "ok": false,
    "processes": [],
    "status": "error|unavailable",
    "error": "string",
    "observation_source": "real",
    "source": "nvidia-smi|none"
  },
  "unknown_semantics": {
    "vram_used": "nvidia-smi が [N/A] 等を返す場合、整数 0 や推定値に変換せず文字列 \"unknown\" を返す（_safe_int 経由）",
    "empty_processes_on_success": "rows 空かつ ok=true は「GPU プロセスなし」を意味する（固定リストではない）",
    "insufficient_permissions_name": "process_name が [Insufficient Permissions] の場合も name としてその文字列を返す（推測名で置換しない）"
  },
  "side_effect": "read_only",
  "required_permission": ["visibility:agent"],
  "authentication": "none",
  "network_access": false,
  "filesystem_access": "none",
