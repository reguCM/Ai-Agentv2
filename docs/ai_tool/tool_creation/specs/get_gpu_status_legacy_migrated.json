{
  "tool_id": "local:get_gpu_status",
  "name": "get_gpu_status",
  "version": "1.0.0-legacy-migrated",
  "description": "GPUの基本状態を取得する。GPUモデル、温度、使用率、VRAM使用量を nvidia-smi から実測する。取得不能時は unknown/unavailable を返し固定値へフォールバックしない。",
  "provider": "local",
  "source": "registry/tools.json",
  "capability": ["GPU", "VRAM", "温度", "使用率", "observation"],
  "purpose": "nvidia-smi --query-gpu から GPU 基本メトリクスを実測して返す（Registry 登録 Legacy Tool の現行契約固定）",
  "allowed_operations": ["read"],
  "prohibited_operations": ["write", "modify", "network"],
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "gpu": {},
      "temperature": {},
      "utilization": {},
      "vram_used": {},
      "vram_total": {},
      "ok": { "type": "boolean" },
      "status": {},
      "error": {},
      "observation_source": { "const": "real" },
      "source": {}
    },
    "required": [
      "gpu",
      "temperature",
      "utilization",
      "vram_used",
      "vram_total",
      "ok",
      "status",
      "error",
      "observation_source",
      "source"
    ]
  },
  "output_fields": {
    "gpu": {
      "type_success": "string",
      "type_failure": "string",
      "unit": "none",
      "meaning": "nvidia-smi query-gpu name（GPU 0 のデバイス名）",
      "observation_source": "nvidia-smi name",
      "unknown_condition": "ok=false のとき文字列 \"unknown\"（推測値ではない）"
    },
    "temperature": {
      "type_success": "number",
      "type_failure": "string",
      "unit": "celsius",
      "meaning": "nvidia-smi temperature.gpu",
      "observation_source": "nvidia-smi",
      "unknown_condition": "パース不能・欠測時は文字列 \"unknown\"；N/A 等も \"unknown\""
    },
    "utilization": {
      "type_success": "number",
      "type_failure": "string",
      "unit": "percent",
      "meaning": "nvidia-smi utilization.gpu（GPU 使用率 %）",
      "observation_source": "nvidia-smi",
      "unknown_condition": "パース不能・欠測時は文字列 \"unknown\"；スナップショット間で変動し得る（KNOWN_LIMITATION）"
    },
    "vram_used": {
      "type_success": "integer",
      "type_failure": "string",
      "unit": "mib",
      "meaning": "nvidia-smi memory.used（使用中 VRAM）",
      "observation_source": "nvidia-smi",
      "unknown_condition": "パース不能・欠測時は文字列 \"unknown\"；スナップショット間で変動し得る"
    },
    "vram_total": {
      "type_success": "integer",
      "type_failure": "string",
      "unit": "mib",
      "meaning": "nvidia-smi memory.total（VRAM 総量）",
      "observation_source": "nvidia-smi",
      "unknown_condition": "パース不能・欠測時は文字列 \"unknown\""
    },
    "ok": {
      "type": "boolean",
      "meaning": "観測成功=true / 失敗=false",
      "observation_source": "DERIVED_VALUE"
    },
    "status": {
      "type": "string",
      "meaning": "成功時 \"ok\"；nvidia-smi 不在 \"unavailable\"；その他失敗 \"error\" 等",
      "observation_source": "DERIVED_VALUE"
    },
    "error": {
      "type": "string|null",
      "meaning": "失敗理由コード（例: nvidia-smi_not_found, nvidia_smi_timeout）；成功時 null",
      "observation_source": "DERIVED_VALUE"
    },
    "observation_source": {
      "type": "string",
      "const": "real",
      "meaning": "観測ラベル。成功/失敗に関わらず常に \"real\"（架空成功値を返さない契約）",
      "observation_source": "CONFIG_VALUE"
    },
    "source": {
      "type": "string",
      "meaning": "取得経路: \"nvidia-smi\" | \"none\"（バイナリ不在）",
      "observation_source": "DERIVED_VALUE"
    }
  },
  "success_format": "ok=true かつ gpu/temperature/utilization/vram_* が nvidia-smi 由来（数値または文字列名）",
  "error_format": {
    "ok": false,
    "status": "error|unavailable",
    "error": "string",
    "gpu": "unknown",
    "temperature": "unknown",
    "utilization": "unknown",
    "vram_used": "unknown",
    "vram_total": "unknown",
    "observation_source": "real",
    "source": "nvidia-smi|none"
  },
  "side_effect": "read_only",
  "required_permission": ["visibility:agent"],
  "authentication": "none",
  "network_access": false,
  "filesystem_access": "none",
  "external_service_access": ["nvidia-smi"],
  "risk_level": "low",
  "expected_failure": [
    "nvidia-smi_not_found",
    "nvidia_smi_timeout",
    "nvidia_smi_failed",
    "nvidia_smi_empty"
  ],
  "retry_policy": "none",
  "deterministic": false,
  "known_limitations": [
    "NVIDIA GPU + nvidia-smi 必須",
    "複数 GPU 環境では GPU index 0 のみ（rows[0]）— 他 GPU は返さない",
    "utilization / vram_used は観測時刻により独立再実行と完全一致しない場合がある",
    "失敗時メトリクスは数値 null ではなく文字列 \"unknown\" になる場合がある"
  ],
  "cost": "free",
