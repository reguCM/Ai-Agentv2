{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent.local/schemas/registry/project_assets.schema.json",
  "title": "Project governance asset registry",
  "description": "Machine-readable project governance registry. Records last verified state and freshness, not live repository truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_role", "assets"],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "registry_role": {
      "const": "project_governance_registry"
    },
    "note": {
      "type": "string"
    },
    "human_view_path": {
      "type": "string",
      "description": "Generated human-readable index path."
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset_entry" }
    }
  },
  "$defs": {
    "asset_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "scope_id": {
      "type": "string",
      "enum": ["HOST", "REPOSITORY", "CURSOR", "PRODUCTION", "EXPERIMENT", "EXTERNAL"]
    },
    "category_id": {
      "type": "string",
      "enum": [
        "Policy",
        "Cursor Rule",
        "Registry",
        "Guard / Gate",
        "Schema / Contract",
        "Skill",
        "Harness",
        "Index",
        "Audit",
        "Safety Rule",
        "Runtime Guard",
        "Project Rule",
        "Adapter"
      ]
    },
    "asset_status": {
      "type": "string",
      "enum": [
        "IMPLEMENTED",
        "RULE_ONLY",
        "DOCUMENT_ONLY",
        "GENERATED",
        "PROVISIONAL",
        "LEGACY",
        "UNKNOWN"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": ["VERIFIED", "POSSIBLY_STALE", "STALE", "UNKNOWN"]
    },
    "enforcement_level": {
      "type": "string",
      "enum": [
        "DOCUMENTATION",
        "GUIDANCE",
        "PROMPT_CONSTRAINT",
        "VALIDATED",
        "ENFORCED",
        "NOT_CONNECTED",
        "UNKNOWN"
      ]
    },
    "generated_or_manual": {
      "type": "string",
      "enum": ["manual", "generated", "mixed"]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshness",
        "last_verified_at",
        "verified_revision",
        "verification_method"
      ],
      "properties": {
        "freshness": { "$ref": "#/$defs/freshness" },
        "last_verified_at": {
          "type": "string",
          "description": "ISO-8601 timestamp of last verification."
        },
        "verified_revision": {
          "type": "string",
          "description": "Git revision at verification time, or NOT_OBSERVED."
        },
        "verification_method": {
          "type": "string"
        },
        "verification_id": {
          "type": "string",
          "description": "Stable id for verification evidence artifact."
        },
        "evidence_ref": {
          "type": "string",
          "description": "Repository-relative path to verification evidence JSON."
        },
        "stale_reason": {
          "type": "string"
        }
      }
    },
    "freshness_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["path", "asset_id"] },
        "path": { "type": "string" },
        "asset_id": { "$ref": "#/$defs/asset_id" }
      },
      "oneOf": [
        {
          "properties": { "kind": { "const": "path" } },
          "required": ["path"]
        },
        {
          "properties": { "kind": { "const": "asset_id" } },
          "required": ["asset_id"]
        }
      ]
    },
    "asset_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "name",
        "scope",
        "category",
        "status",
        "source_of_truth",
        "generated_or_manual",
        "consumers",
        "enforcement_level",
        "verification"
      ],
      "properties": {
        "asset_id": { "$ref": "#/$defs/asset_id" },
        "name": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "description": "Primary repository-relative path when applicable."
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/scope_id" }
        },
        "category": { "$ref": "#/$defs/category_id" },
        "status": { "$ref": "#/$defs/asset_status" },
        "source_of_truth": { "type": "string", "minLength": 1 },
        "generated_or_manual": { "$ref": "#/$defs/generated_or_manual" },
        "consumers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "enforcement_level": { "$ref": "#/$defs/enforcement_level" },
        "related_tests": {
          "type": "array",
          "items": { "type": "string" }
        },
        "related_validators": {
          "type": "array",
          "items": { "type": "string" }
        },
        "related_policies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "related_assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/asset_id" }
        },
        "freshness_dependencies": {
          "type": "array",
          "description": "Directed staleness inputs only; not general related_assets.",
          "items": { "$ref": "#/$defs/freshness_dependency" }
        },
        "verification": { "$ref": "#/$defs/verification" },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
