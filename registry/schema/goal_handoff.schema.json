{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent.local/schemas/registry/goal_handoff.schema.json",
  "title": "Goal handoff packet",
  "description": "Machine-readable bridge from Dev Skill workflow to implementation. PROVISIONAL v0.1. Not a Production Runtime mission record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handoff_version",
    "handoff_id",
    "status",
    "provisional",
    "created_at",
    "source",
    "goal",
    "scope",
    "acceptance_criteria",
    "implementation_tasks",
    "test_plan",
    "human_gates",
    "runtime_boundary"
  ],
  "properties": {
    "handoff_version": {
      "const": "0.1",
      "description": "Packet format version."
    },
    "handoff_id": {
      "type": "string",
      "pattern": "^gh-[0-9]{8}T[0-9]{6}Z-[a-z0-9][a-z0-9-]{0,62}$",
      "description": "Stable id. Recommended: gh-YYYYMMDDTHHMMSSZ-slug"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "ready", "superseded"],
      "description": "ready means human-approved for implementation start."
    },
    "provisional": {
      "const": true,
      "description": "Remains true until Goal Handoff is promoted beyond PROVISIONAL."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes": {
      "type": "string",
      "description": "Optional prior handoff_id replaced by this packet."
    },
    "source": { "$ref": "#/$defs/source_block" },
    "source_binding": { "$ref": "#/$defs/source_binding" },
    "requirement_bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement_binding" },
      "description": "Identity-only coverage from Mission Requirements to existing Task and Acceptance ids."
    },
    "goal": { "$ref": "#/$defs/goal_block" },
    "scope": { "$ref": "#/$defs/scope_block" },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/acceptance_item" }
    },
    "implementation_tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/implementation_task" }
    },
    "test_plan": { "$ref": "#/$defs/test_plan_block" },
    "human_gates": {
      "type": "array",
      "items": { "$ref": "#/$defs/human_gate" },
      "description": "[] means no extra human gates beyond repository policy defaults."
    },
    "risks": {
      "type": "array",
      "items": { "$ref": "#/$defs/risk_item" }
    },
    "open_questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "runtime_boundary": { "$ref": "#/$defs/runtime_boundary_block" },
    "preconditions": {
      "type": "array",
      "items": { "$ref": "#/$defs/precondition_record" },
      "description": "Optional start-of-work preconditions. Presence does not imply satisfaction; see evaluation.status."
    }
  },
  "$defs": {
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_id", "requirement_ids"],
      "properties": {
        "mission_id": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to the Mission canonical record; no Human Meaning is copied here."
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "References to Mission structured_requirements consumed by Production specification generation."
        }
      }
    },
    "requirement_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "task_ids", "acceptance_ids"],
      "properties": {
        "requirement_id": { "type": "string", "minLength": 1 },
        "task_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^T[0-9]+$" },
          "uniqueItems": true
        },
        "acceptance_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^A[0-9]+$" },
          "uniqueItems": true
        }
      },
      "anyOf": [
        { "properties": { "task_ids": { "minItems": 1 } } },
        { "properties": { "acceptance_ids": { "minItems": 1 } } }
      ]
    },
    "source_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "documents"],
      "properties": {
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "Local skill ids used to produce this packet."
        },
        "documents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["plan", "task_list"],
          "properties": {
            "prd": {
              "type": "string",
              "description": "Repository-relative PRD path, if produced."
            },
            "tech_spec": {
              "type": "string",
              "description": "Repository-relative tech spec path, if produced."
            },
            "knowledge_map": {
              "type": "string",
              "description": "Repository-relative graph-engineering artifact, if persisted."
            },
            "plan": {
              "type": "string",
              "minLength": 1,
              "description": "Usually tasks/plan.md"
            },
            "task_list": {
              "type": "string",
              "minLength": 1,
              "description": "Usually tasks/todo.md or external tracker reference encoded as path/note."
            }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": { "type": "string" },
            "head": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,40}$"
            },
            "worktree": { "type": "string" }
          },
          "description": "Observed at packet creation. Informational only."
        }
      }
    },
    "goal_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "description": "One-paragraph implementation goal for the implementing agent."
        },
        "original_request_excerpt": {
          "type": "string",
          "description": "Optional short excerpt of the user's original ask. Not a Mission original_goal replacement."
        }
      }
    },
    "scope_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "non_goals", "affected_paths"],
      "properties": {
        "in_scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "non_goals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "affected_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Repository-relative paths or directory prefixes expected to change."
          },
          "uniqueItems": true
        }
      }
    },
    "acceptance_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "verification"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A[0-9]+$"
        },
        "statement": { "type": "string", "minLength": 1 },
        "verification": { "type": "string", "minLength": 1 }
      }
    },
    "implementation_task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "acceptance",
        "verification",
        "size"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T[0-9]+$"
        },
        "title": { "type": "string", "minLength": 1 },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "pattern": "^T[0-9]+$" },
          "uniqueItems": true
        },
        "size": {
          "type": "string",
          "enum": ["S", "M", "L", "XL"],
          "description": "L/XL should be split before status=ready."
        },
        "maps_to_acceptance": {
          "type": "array",
          "items": { "type": "string", "pattern": "^A[0-9]+$" },
          "uniqueItems": true
        },
        "decision_premises": {
          "type": "array",
          "items": { "$ref": "#/$defs/decision_premise" },
          "description": "Human Decisions this task was derived from at handoff creation time."
        }
      }
    },
    "decision_premise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_key", "derived_from_decision_id"],
      "properties": {
        "decision_key": {
          "type": "string",
          "minLength": 1,
          "description": "Semantic identity of the premise decision (what it is about)."
        },
        "derived_from_decision_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable decision_id that was active when this task was generated."
        },
        "validated_against_decision_id": {
          "type": "string",
          "minLength": 1,
          "description": "Latest decision_id this task was semantically validated against."
        }
      }
    },
    "test_plan_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pytest"],
      "properties": {
        "pytest": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Repository-relative pytest targets or node ids."
        },
        "e2e": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "manual": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "human_gate": {
      "type": "string",
      "enum": [
        "git_push",
        "merge_to_stable",
        "promote_to_master",
        "production_e2e",
        "architecture_review",
        "security_review"
      ]
    },
    "risk_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "impact", "mitigation"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "impact": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "mitigation": { "type": "string", "minLength": 1 }
      }
    },
    "runtime_boundary_block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_connected", "notes"],
      "properties": {
        "production_connected": {
          "type": "boolean",
          "const": false,
          "description": "Must remain false until an explicit Runtime integration is CONNECTED."
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "description": "Explicit boundary statement for implementers."
        }
      }
    },
    "precondition_evaluation_status": {
      "type": "string",
      "enum": ["UNKNOWN", "SATISFIED", "UNSATISFIED", "WAITING", "NOT_APPLICABLE"]
    },
    "precondition_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": { "$ref": "#/$defs/precondition_evaluation_status" },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "precondition_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precondition_id",
        "key",
        "description",
        "blocking",
        "source",
        "evaluation"
      ],
      "properties": {
        "precondition_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^pc-[a-z0-9][a-z0-9_-]{0,62}$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]{0,127}$"
        },
        "description": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 },
        "evaluation": { "$ref": "#/$defs/precondition_evaluation" }
      },
      "description": "Mirrors registry/schema/precondition_contract.schema.json#/$defs/precondition_record"
    }
  }
}
