{
  "tool_id": "local:workspace_read_text_scoped",
  "name": "workspace_read_text_scoped",
  "provider": "local",
  "version": "0.1.0-draft",
  "description": "experimental allowlist 内のテキストファイルを読み取る（read-only）。docs/ai_tool・runs/ai_tool・tool_creation/specs のみ。workspace 全体は対象外。",
  "capabilities": ["filesystem", "read", "text", "scoped"],
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "path": {"type": "string", "description": "許可ルート内の相対パス（リポジトリ root 基準）"},
      "offset": {"type": "integer", "minimum": 1, "description": "開始行（1-based、任意）"},
      "limit": {"type": "integer", "minimum": 1, "description": "返す最大行数（任意）"}
    },
    "required": ["path"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "ok": {"type": "boolean"},
      "path": {"type": "string"},
      "root_id": {"type": "string"},
      "size_bytes": {"type": "integer"},
      "total_lines": {"type": "integer"},
      "offset": {"type": "integer"},
      "limit": {"type": ["integer", "null"]},
      "returned_lines": {"type": "integer"},
      "content": {"type": "string"},
      "truncated": {"type": "boolean"},
      "error": {"type": ["string", "null"]}
    },
    "required": ["ok", "path", "error"]
  },
  "side_effect": "read_only",
  "permissions": ["visibility:experimental"],
  "network_access": false,
  "filesystem_access": "read",
  "risk_level": "low",
  "cost": "free",
  "tool_status": "unavailable",
  "experiment_status": "experimental",
  "adoption_status": "not_reviewed",
  "spec_ref": "docs/ai_tool/tool_creation/specs/local_workspace_read_text_scoped.json",
  "provider_specific": {
    "allowlist_config": "docs/ai_tool/tool_creation/allowed_roots.experimental.json",
    "implementation_module": "ai_tool.experimental.scoped_read.reader",
    "implementation_function": "workspace_read_text_scoped",
    "registry_visibility": "experimental"
  }
}
